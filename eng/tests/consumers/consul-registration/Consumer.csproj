<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ServiceMantle.PackageConsumer.ConsulRegistration</RootNamespace>
    <AssemblyName>ServiceMantle.PackageConsumer.ConsulRegistration</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ServiceMantle" Version="[__SERVICEMANTLE_VERSION__]" />
    <PackageReference Include="ServiceMantle.Consul" Version="[__SERVICEMANTLE_VERSION__]" />
  </ItemGroup>

</Project>
