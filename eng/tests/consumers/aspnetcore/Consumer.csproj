<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ServiceMantle.PackageConsumer.AspNetCore</RootNamespace>
    <AssemblyName>ServiceMantle.PackageConsumer.AspNetCore</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ServiceMantle.AspNetCore" Version="[__SERVICEMANTLE_VERSION__]" />
  </ItemGroup>

</Project>
