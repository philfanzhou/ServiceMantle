<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ServiceMantle.PackageConsumer.DatabasePostgreSql</RootNamespace>
    <AssemblyName>ServiceMantle.PackageConsumer.DatabasePostgreSql</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ServiceMantle.Database.PostgreSql" Version="[__SERVICEMANTLE_VERSION__]" />
  </ItemGroup>

</Project>
