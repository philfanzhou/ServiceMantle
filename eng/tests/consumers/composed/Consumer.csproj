<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ServiceMantle.PackageConsumer.Composed</RootNamespace>
    <AssemblyName>ServiceMantle.PackageConsumer.Composed</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ServiceMantle.Web" Version="[__SERVICEMANTLE_VERSION__]" />
    <PackageReference Include="ServiceMantle.Database.Sqlite" Version="[__SERVICEMANTLE_VERSION__]" />
    <PackageReference Include="ServiceMantle.Diagnostics" Version="[__SERVICEMANTLE_VERSION__]" />
    <PackageReference Include="ServiceMantle.Persistence.Relational" Version="[__SERVICEMANTLE_VERSION__]" />
    <PackageReference Include="ServiceMantle.Logging" Version="[__SERVICEMANTLE_VERSION__]" />
  </ItemGroup>

</Project>
