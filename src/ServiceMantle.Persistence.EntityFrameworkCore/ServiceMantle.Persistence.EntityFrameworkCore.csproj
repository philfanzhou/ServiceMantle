<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ServiceMantle.Persistence.EntityFrameworkCore</RootNamespace>
    <AssemblyName>ServiceMantle.Persistence.EntityFrameworkCore</AssemblyName>
    <PackageId>ServiceMantle.Persistence.EntityFrameworkCore</PackageId>
    <IsPackable>true</IsPackable>
    <PackageDescription>EF Core models, shared installation stores, and encrypted Data Protection key persistence for ServiceMantle.</PackageDescription>
    <PackageTags>service-management aspnetcore bootstrap persistence entity-framework-core installation data-protection</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\ServiceMantle\\ServiceMantle.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
