<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ServiceMantle.Persistence.EntityFrameworkCore</RootNamespace>
    <AssemblyName>ServiceMantle.Persistence.EntityFrameworkCore</AssemblyName>
    <PackageId>ServiceMantle.Persistence.EntityFrameworkCore</PackageId>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageDescription>EF Core models and shared installation store integration for ServiceMantle.</PackageDescription>
    <PackageTags>service-management aspnetcore bootstrap persistence entity-framework-core installation</PackageTags>
    <RepositoryUrl>https://github.com/philfanzhou/ServiceMantle</RepositoryUrl>
    <TargetFramework>net10.0</TargetFramework>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\ServiceMantle\\ServiceMantle.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>

