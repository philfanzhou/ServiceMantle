<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>ServiceMantle.OpenTelemetry.Prometheus</RootNamespace>
    <AssemblyName>ServiceMantle.OpenTelemetry.Prometheus</AssemblyName>
    <PackageId>ServiceMantle.OpenTelemetry.Prometheus</PackageId>
    <PackageDescription>Authorized Prometheus scraping endpoint for ServiceMantle OpenTelemetry metrics.</PackageDescription>
    <PackageTags>service-management;opentelemetry;prometheus;metrics;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <ProjectReference Include="..\ServiceMantle.AspNetCore\ServiceMantle.AspNetCore.csproj" />
    <ProjectReference Include="..\ServiceMantle.OpenTelemetry\ServiceMantle.OpenTelemetry.csproj" />
  </ItemGroup>

</Project>
